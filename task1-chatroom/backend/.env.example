# Copy to .env. Secrets stay in this backend directory only.
# auto = real model if a key is present, otherwise explicitly labeled demo.
# demo = always mock; live = require a key, report an error if missing.
# Real acceptance: fill this backend-only file locally, never paste keys into chat.
# scripts/validate_real_llm.py refuses to run provider tests without a nonempty key.
LLM_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./chatroom.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
